# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Generated visual output (rebuildable from model.py/scene.py)
Visuals/*/out/
Visuals/_site/

# Vendored offline assets (large, fetched via `viz.py vendor`)
Visuals/_lib/vendor/

# Data artifacts that are regenerated by model.py (keep the folder, drop contents)
# Uncomment if you don't want simulated CSV/parquet output tracked:
# Visuals/*/data/*
# !Visuals/*/data/.gitkeep

# R
.Rhistory
.RData
.Rproj.user/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Logs / temp
*.log
.tmp/

# graphify (regenerated via `graphify update .`)
graphify-out/
